{
  "name": "@internal/plugin-dev-insights",
  "version": "0.1.0",
  "description": "Backstage frontend plugin: developer productivity dashboard (build times, deployment frequency, PR cycle time) with LLM team health reports",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "dev-insights",
    "pluginPackages": [
      "@internal/plugin-dev-insights",
      "@internal/plugin-dev-insights-backend"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/core-components": "^0.18.15",
    "@backstage/core-plugin-api": "^1.12.11",
    "@backstage/errors": "^1.3.2",
    "@backstage/plugin-catalog-react": "^3.3.0",
    "@material-ui/core": "^4.12.4",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/dev-utils": "^1.1.28",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "files": [
    "dist"
  ]
}
