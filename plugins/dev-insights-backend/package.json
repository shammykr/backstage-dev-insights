{
  "name": "@internal/plugin-dev-insights-backend",
  "version": "0.1.0",
  "description": "Backstage backend plugin that aggregates GitHub delivery metrics across teams and generates LLM team health reports",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "dev-insights"
  },
  "configSchema": "config.d.ts",
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.11.0",
    "@backstage/config": "^1.3.10",
    "@backstage/errors": "^1.3.2",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.18.1",
    "@backstage/backend-test-utils": "^1.11.8",
    "@backstage/cli": "^0.36.7",
    "@types/express": "^4.17.6"
  },
  "files": [
    "dist",
    "config.d.ts"
  ]
}
